# Copy to .env and fill in. Never commit .env. Real environment variables win over this file.
# docker-compose.yml reads this file too (env_file), and overrides OLLAMA_URL, SPENDLY_DB_PATH
# and HF_HOME with the container's values.

# Flask session secret. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Only for `python app.py` (gunicorn in Docker never uses debug mode)
SPENDLY_DEBUG=true
SPENDLY_PORT=5001

# Which LLM runs the AI features: ollama (local, default) or groq (cloud, e.g. on AWS without a GPU).
# Voice input always stays on local faster-whisper (CPU).
LLM_PROVIDER=ollama

# Groq (only used when LLM_PROVIDER=groq). Get a key at https://console.groq.com/keys.
# SECRET: never commit it, never paste it into a chat or a log.
GROQ_API_KEY=
# Chat model: strong tool calling. Vision model: reads receipts (empty = receipt scanning off).
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Only change for a proxy / gateway in front of Groq
GROQ_BASE_URL=https://api.groq.com

# Local Ollama. On Windows: http://localhost:11434 (Docker sets host.docker.internal itself)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=gemma3:4b

# faster-whisper model for voice input (tiny, base, small, medium)
WHISPER_MODEL=small

# Database file. Leave empty for database/spendly.db
SPENDLY_DB_PATH=

# Spendly MCP server: the ONE Spendly account that Claude acts as (must already exist).
SPENDLY_USER_EMAIL=you@example.com
